<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.ravon.mapper.UserDao">

    <resultMap id="BaseResultMap" type="tech.ravon.model.inver.User">
        <id property="userId" column="user_id" jdbcType="BIGINT"/>
        <result property="username" column="username" jdbcType="VARCHAR"/>
        <result property="email" column="email" jdbcType="VARCHAR"/>
        <result property="phone" column="phone" jdbcType="VARCHAR"/>
        <result property="password" column="password" jdbcType="VARCHAR"/>
        <result property="classId" column="class_id" jdbcType="BIGINT"/>
        <result property="avatarUrl" column="avatar_url" jdbcType="VARCHAR"/>
        <result property="authority" column="authority" jdbcType="OTHER"/>
    </resultMap>

    <sql id="Base_Column_List">
        user_id, username, email,
        phone, password, class_id,
        avatar_url, authority
    </sql>

    <!-- 根据 identifier 和 password 验证用户登录 -->
    <select id="checkUserLogin" resultMap="BaseResultMap">
        SELECT *
        FROM users
        WHERE
            (CAST(user_id AS TEXT) = #{identifier} OR email = #{identifier} OR phone = #{identifier})
          AND password = #{password}
            LIMIT 1
    </select>

    <!-- 根据 identifier 获取用户信息 -->
    <select id="getUserInfo" resultMap="BaseResultMap">
        SELECT *
        FROM users
        WHERE CAST(user_id AS TEXT) = #{identifier} OR email = #{identifier} OR phone = #{identifier}
            LIMIT 1
    </select>

    <!-- 插入新用户 -->
    <insert id="doUserRegister">
        INSERT INTO users (username, avatar_url, email, phone, password, authority)
        VALUES (
                   #{username},
                   null,
                   #{email},
                   #{phone},
                   #{password},
                   COALESCE(#{authority}, 'normal')::authority_type
               )
    </insert>


    <!-- 根据 email 查询刚插入的用户信息 -->
    <select id="getUserByEmail" resultMap="BaseResultMap">
        SELECT *
        FROM users
        WHERE email = #{email}
    </select>

    <!-- 注销用户 -->
    <delete id="unregisterUser">
        DELETE FROM users
        WHERE user_id = #{userId}
    </delete>

    <!-- 删除用户相关的 viewrecords -->
    <delete id="deleteUserFileViewRecords">
        DELETE FROM view_records
        WHERE user_id = #{userId}
    </delete>

    <!-- 更新用户信息 -->
    <update id="updateUserInfo">
        UPDATE users
        SET username = #{username},
            email = #{email},
            phone = #{phone},
            password = #{password}
        WHERE user_id = #{userId}
    </update>

</mapper>
