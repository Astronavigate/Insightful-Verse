<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="tech.ravon.mapper.AnnotationDao">

    <!-- =========================
         ResultMap
    ========================== -->
    <resultMap id="BaseResultMap" type="tech.ravon.model.iviep.Annotation">
        <id property="id" column="note_id" jdbcType="BIGINT"/>

        <result property="userId" column="user_id" jdbcType="BIGINT"/>
        <result property="bookId" column="book_id" jdbcType="VARCHAR"/>
        <result property="type" column="note_type" jdbcType="VARCHAR"/>
        <result property="cfi" column="note_cfi" jdbcType="VARCHAR"/>
        <result property="content" column="note_content" jdbcType="VARCHAR"/>
        <result property="color" column="note_color" jdbcType="VARCHAR"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- =========================
         Base Columns
    ========================== -->
    <sql id="Base_Column_List">
        note_id,
        user_id,
        book_id,
        note_type,
        note_cfi,
        note_content,
        note_color,
        created_at,
        updated_at
    </sql>

    <!-- =========================
         Query
    ========================== -->

    <!-- 获取用户在某本书下的所有标注 -->
    <select id="getAnnotationsByUserAndBook"
            resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM annotations
        WHERE user_id = #{userId}
        AND book_id = #{bookId}
        ORDER BY created_at ASC
    </select>

    <!-- 按类型获取标注 -->
    <select id="getAnnotationsByType"
            resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM annotations
        WHERE user_id = #{userId}
        AND book_id = #{bookId}
        AND note_type = #{type}
        ORDER BY created_at ASC
    </select>

    <!-- =========================
         Insert / Update
    ========================== -->

    <!-- 新增 or 更新标注 -->
    <insert id="insertAnnotation"
            parameterType="tech.ravon.model.iviep.Annotation">
        <choose>
            <when test="id == null">
                INSERT INTO annotations
                (user_id, book_id, note_type, note_cfi, note_content, note_color, created_at, updated_at)
                VALUES
                (#{userId}, #{bookId}, #{type}, #{cfi},
                #{content}, #{color}, NOW(), NOW())
            </when>
            <otherwise>
                UPDATE annotations
                SET
                note_type = #{type},
                note_cfi = #{cfi},
                note_content = #{content},
                note_color = #{color},
                updated_at = NOW()
                WHERE note_id = #{id}
                AND user_id = #{userId}
            </otherwise>
        </choose>
    </insert>

    <!-- =========================
         Delete
    ========================== -->

    <!-- 删除单条标注 -->
    <delete id="deleteAnnotation">
        DELETE FROM annotations
        WHERE note_id = #{id}
          AND user_id = #{userId}
    </delete>

    <!-- 删除某本书下的所有标注 -->
    <delete id="deleteAnnotationsByUserAndBook">
        DELETE FROM annotations
        WHERE user_id = #{userId}
          AND book_id = #{bookId}
    </delete>

    <delete id="deleteAnnotationsByBook">
        DELETE FROM annotations
        WHERE book_id = #{bookId}
    </delete>

    <delete id="deleteAnnotationsByUser">
        DELETE FROM annotations
        WHERE user_id = #{userId}
    </delete>

</mapper>
