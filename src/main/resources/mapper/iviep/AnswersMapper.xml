<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.ravon.mapper.AnswerDao">

    <resultMap id="BaseResultMap" type="tech.ravon.model.inver.Answer">
        <id property="answerId" column="answer_id" jdbcType="BIGINT"/>
        <result property="questionId" column="question_id" jdbcType="BIGINT"/>
        <result property="submitterId" column="submitter_id" jdbcType="BIGINT"/>
        <result property="answerContent" column="answer_content" jdbcType="VARCHAR"/>
        <result property="answerScore" column="answer_score" jdbcType="FLOAT"/>
        <result property="submissionDate" column="submission_date" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        answer_id,question_id,submitter_id,answer_content,answer_score,submission_date
    </sql>
</mapper>
