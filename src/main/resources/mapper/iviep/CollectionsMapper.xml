<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.ravon.mapper.CollectionDao">

    <resultMap id="BaseResultMap" type="tech.ravon.model.inver.Collections">
        <id property="collectionId" column="collection_id" jdbcType="BIGINT"/>
        <result property="userId" column="user_id" jdbcType="BIGINT"/>
        <result property="collectionName" column="collection_name" jdbcType="VARCHAR"/>
        <result property="collectionDescription" column="collection_description" jdbcType="VARCHAR"/>
        <result property="favoriteTime" column="favorite_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        collection_id,user_id,collection_name,collection_description,favorite_time
    </sql>

    <select id="getCollectionById" resultType="tech.ravon.model.inver.Collections" resultMap="BaseResultMap">
        SELECT * FROM collections WHERE collection_id = #{collectionId}
    </select>

    <select id="getAllCollections" resultType="tech.ravon.model.inver.Collections" resultMap="BaseResultMap">
        SELECT * FROM collections
    </select>

    <select id="getCollectionsByUser" resultType="tech.ravon.model.inver.Collections" resultMap="BaseResultMap">
        SELECT * FROM collections WHERE user_id = #{userId}
        <if test="collectionName != null or collectionName != ''">
            AND collection_name = #{collectionName}
        </if>
    </select>

    <insert id="updateCollection" parameterType="tech.ravon.model.inver.Collections">
        <choose>
            <when test="collectionId == null or collectionId == ''">
                INSERT INTO collections (user_id, collection_name, collection_description)
                VALUES (#{userId}, #{collectionName}, #{collectionDescription})
            </when>
            <otherwise>
                UPDATE collections
                SET collection_name = #{collectionName}, collection_description = #{collectionDescription}
                WHERE collection_id = #{collectionId}
            </otherwise>
        </choose>
    </insert>

    <delete id="deleteCollection">
        DELETE FROM collections WHERE collection_id = #{collectionId};
    </delete>
</mapper>
